# Warehouse IoT Frontend Environment Configuration
# This allows the frontend to connect to the backend from any device on the network

# Backend API URL - Change this to your Raspberry Pi's IP address
# Format: http://<raspberry_pi_ip>:5000/api
# ⚠️  DO NOT SET VITE_API_URL HERE.
# All network config is centralized in the root .env file.
# Vite reads it automatically via envDir: '../' in vite.config.ts
#
# To change the IP, edit: /root/Forklift_Monitoring/.env
# Set SERVER_IP and update VITE_API_URL / VITE_WS_URL there.
