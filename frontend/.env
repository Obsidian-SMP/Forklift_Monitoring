# Warehouse IoT Frontend Environment Configuration
# This allows the frontend to connect to the backend from any device on the network

# Backend API URL - Change this to your Raspberry Pi's IP address
# Format: http://<raspberry_pi_ip>:5000/api
VITE_API_URL=http://10.136.57.165:5000/api

# WebSocket URL for real-time updates
# Format: ws://<raspberry_pi_ip>:5000
VITE_WS_URL=ws://10.136.57.165:5000

# Note: When accessing from another device on the network:
# 1. Make sure both devices are on the same network
# 2. The Raspberry Pi IP (10.136.57.165) should be reachable
# 3. Access the frontend at http://10.136.57.165:5173
# 4. Camera images will load from the backend API
