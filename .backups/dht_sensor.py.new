"""
DHT Sensor Reader - Temperature & Humidity from GPIO Pin 40 (BCM 21)
Direct GPIO implementation without adafruit library
"""

import time
import random
from datetime import datetime
import threading

try:
    import RPi.GPIO as GPIO
    GPIO_AVAILABLE = True
except Exception as e:
    GPIO_AVAILABLE = False
    print(f"⚠️  RPi.GPIO not available: {e}")

# GPIO pin configuration
DHT_PIN = 21  # GPIO pin 40 = BCM 21

class DHTSensor:
    def __init__(self):
        """Initialize DHT sensor"""
        self.last_reading = None
        self.last_read_time = None
        self.lock = threading.Lock()
        self.sensor_available = False
        
        if GPIO_AVAILABLE:
            try:
                GPIO.setmode(GPIO.BCM)
                GPIO.setwarnings(False)
                self.sensor_available = True
                print("✓ DHT sensor GPIO initialized (pin 21)")
            except Exception as e:
                print(f"GPIO setup error: {e}")
                self.sensor_available = False
        else:
            print("⚠️  DHT sensor not available (GPIO library not found)")
    
    def read_dht(self):
        """Read DHT sensor using direct GPIO bit-banging"""
        if not GPIO_AVAILABLE:
            return None
        
        try:
            # Set pin as output and pull low for 18ms
            GPIO.setup(DHT_PIN, GPIO.OUT)
            GPIO.output(DHT_PIN, GPIO.LOW)
            time.sleep(0.018)
            
            # Release pin and switch to input
            GPIO.output(DHT_PIN, GPIO.HIGH)
            GPIO.setup(DHT_PIN, GPIO.IN)
            
            # Wait for sensor to respond
            time.sleep(0.00001)
            
            # Read 40 bits
            bits = []
            for i in range(40):
                # Wait for HIGH
                count = 0
                while GPIO.input(DHT_PIN) == GPIO.LOW and count < 1000:
                    count += 1
                    time.sleep(0.000001)
                
                # Measure HIGH duration
                high_count = 0
                while GPIO.input(DHT_PIN) == GPIO.HIGH and high_count < 1000:
                    high_count += 1
                    time.sleep(0.000001)
                
                # If HIGH was long (>500us), it's a 1, else 0
                if high_count > 20:
                    bits.append(1)
                else:
                    bits.append(0)
            
            # Convert bits to bytes
            humidity_int = (bits[0] << 7) | (bits[1] << 6) | (bits[2] << 5) | (bits[3] << 4) | \
                          (bits[4] << 3) | (bits[5] << 2) | (bits[6] << 1) | bits[7]
            
            humidity_dec = (bits[8] << 7) | (bits[9] << 6) | (bits[10] << 5) | (bits[11] << 4) | \
                          (bits[12] << 3) | (bits[13] << 2) | (bits[14] << 1) | bits[15]
            
            temp_int = (bits[16] << 7) | (bits[17] << 6) | (bits[18] << 5) | (bits[19] << 4) | \
                      (bits[20] << 3) | (bits[21] << 2) | (bits[22] << 1) | bits[23]
            
            temp_dec = (bits[24] << 7) | (bits[25] << 6) | (bits[26] << 5) | (bits[27] << 4) | \
                      (bits[28] << 3) | (bits[29] << 2) | (bits[30] << 1) | bits[31]
            
            checksum = (bits[32] << 7) | (bits[33] << 6) | (bits[34] << 5) | (bits[35] << 4) | \
                      (bits[36] << 3) | (bits[37] << 2) | (bits[38] << 1) | bits[39]
            
            # Verify checksum
            expected_checksum = (humidity_int + humidity_dec + temp_int + temp_dec) & 0xFF
            if checksum != expected_checksum:
                return None
            
            temperature = float(temp_int) + float(temp_dec) / 100.0
            humidity = float(humidity_int) + float(humidity_dec) / 100.0
            
            return {
                'temperature': temperature,
                'humidity': humidity,
                'timestamp': datetime.utcnow().isoformat(),
                'status': 'success',
                'source': 'hardware'
            }
        
        except Exception as e:
            print(f"DHT read error: {e}")
            return None
    
    def get_simulated_reading(self):
        """Generate simulated sensor reading"""
        base_temp = 23.0
        base_humidity = 55.0
        
        temp_variation = random.uniform(-2, 2)
        humidity_variation = random.uniform(-5, 5)
        
        return {
            'temperature': round(base_temp + temp_variation, 2),
            'humidity': round(max(0, min(100, base_humidity + humidity_variation)), 2),
            'timestamp': datetime.utcnow().isoformat(),
            'status': 'success',
            'source': 'simulated'
        }
    
    def read(self):
        """Read temperature and humidity from DHT sensor"""
        with self.lock:
            # Cache reading for 2 seconds to avoid excessive sensor reads
            now = datetime.utcnow()
            if self.last_reading and self.last_read_time:
                time_since_last = (now - self.last_read_time).total_seconds()
                if time_since_last < 2.0:
                    # Return cached reading
                    return self.last_reading
            
            # If sensor is not available, return simulated data with unavailable status
            if not self.sensor_available:
                result = self.get_simulated_reading()
                result['status'] = 'unavailable'
                result['source'] = 'simulated - sensor not detected'
                self.last_reading = result
                self.last_read_time = datetime.utcnow()
                return result
            
            # Try to read from hardware
            result = self.read_dht()
            
            if result is None:
                # Hardware read failed, return simulated with unavailable status
                result = self.get_simulated_reading()
                result['status'] = 'unavailable'
                result['source'] = 'simulated - hardware read failed'
            
            self.last_reading = result
            self.last_read_time = datetime.utcnow()
            return result

# Global instance
_dht_sensor = None

def initialize_dht():
    """Initialize DHT sensor"""
    global _dht_sensor
    _dht_sensor = DHTSensor()
    print("✓ DHT sensor initialized (GPIO pin 21)")

def get_dht_reading():
    """Get DHT sensor reading"""
    global _dht_sensor
    if _dht_sensor is None:
        initialize_dht()
    
    return _dht_sensor.read()

# Initialize on import
initialize_dht()


