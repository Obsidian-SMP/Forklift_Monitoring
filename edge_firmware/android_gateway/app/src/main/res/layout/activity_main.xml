<?xml version="1.0" encoding="utf-8"?>
<!-- ==============================================================================
     File: edge_firmware/android_gateway/res/layout/activity_main.xml
     Description: Industrial Card-Based UI Layout with Live RSSI HUD & IMU Telemetry.
     Purpose: Replaces bare Android default layout with high-contrast Material cards,
              a prominent live signal strength meter, packet counters, and live IMU readout.
     ============================================================================== -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@android:drawable/stat_sys_data_bluetooth"
                app:tint="@color/primary_blue"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAREHOUSE BLE GATEWAY"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anchor Node • Phase 0 Telemetry"
                    android:textColor="@color/text_gray_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvServiceStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDLE"
                android:textColor="@color/text_gray_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@color/surface_border" />
        </LinearLayout>

        <!-- CARD 1: LIVE RSSI SIGNAL HUD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SIGNAL STRENGTH (RSSI)"
                        android:textColor="@color/text_gray_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvSignalQualityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO SIGNAL"
                        android:textColor="@color/text_gray_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@color/surface_border" />
                </LinearLayout>

                <!-- Big Numerical RSSI Readout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginVertical="6dp">

                    <TextView
                        android:id="@+id/tvRssiBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- dBm"
                        android:textColor="@color/text_white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvSmoothedSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (Avg: -- dBm)"
                        android:textColor="@color/text_gray_muted"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="6dp" />
                </LinearLayout>

                <!-- Progress Bar Gauge -->
                <ProgressBar
                    android:id="@+id/progressBarRssi"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary_blue"
                    android:progressBackgroundTint="@color/surface_border"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Sub-Stats Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DETECTIONS"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetectionsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/primary_blue"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL SCANS"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScansCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HIT RATE"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHitRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0%"
                            android:textColor="@color/status_green"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2: BEACON IMU VIBRATION TELEMETRY -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BEACON IMU TELEMETRY (DUAL-ROLE)"
                        android:textColor="@color/text_gray_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvBatteryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BAT: --"
                        android:textColor="@color/status_green"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AX"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvAx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.00g"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AY"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvAy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.00g"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AZ"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvAz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1.00g"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|a| MAG"
                            android:textColor="@color/text_gray_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvMagnitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.00g"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 3: GATEWAY & UPSTREAM CONFIGURATION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GATEWAY &amp; NETWORK CONFIGURATION"
                    android:textColor="@color/text_gray_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <!-- Gateway Anchor ID -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Gateway Anchor ID"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGatewayId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="phone_1"
                        android:textColor="@color/text_white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Laptop IP & Port Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="8dp"
                        android:hint="Laptop Edge IP"
                        app:boxStrokeColor="@color/primary_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLaptopIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="192.168.1.50"
                            android:textColor="@color/text_white"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Port"
                        app:boxStrokeColor="@color/primary_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5000"
                            android:inputType="number"
                            android:textColor="@color/text_white"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Beacon Name -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Target BLE Beacon Name"
                    app:boxStrokeColor="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBeaconName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FL_NANO_01"
                        android:textColor="@color/text_white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Transmission Mode Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:paddingVertical="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transmission Mode"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTransmitModeDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Raw RSSI (Lag-Free EKF)"
                            android:textColor="@color/text_gray_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTransmitMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Upstream Latency / Status -->
                <TextView
                    android:id="@+id/tvUpstreamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upstream: Standby (Not Connected)"
                    android:textColor="@color/text_gray_muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="START GATEWAY SCANNER"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/primary_blue"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
