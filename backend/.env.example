# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# SQLite Database Configuration
DATABASE=warehouse_iot.db

# MQTT Broker Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# MQTT Topics
MQTT_TOPIC_FORKLIFT=warehouse/forklift/+/data
MQTT_TOPIC_WAREHOUSE=warehouse/environment/data
MQTT_TOPIC_CAMERA=warehouse/forklift/+/image
MQTT_TOPIC_GPS=warehouse/forklift/+/gps
MQTT_TOPIC_VIBRATION=warehouse/forklift/+/vibration

# Image Processing
UPLOAD_FOLDER=uploads/images
MAX_CONTENT_LENGTH=16777216  # 16MB
YOLO_MODEL=yolov8n.pt  # nano model for Raspberry Pi

# Alert Thresholds
TEMP_MIN=15
TEMP_MAX=30
HUMIDITY_MIN=30
HUMIDITY_MAX=70
VIBRATION_THRESHOLD=5.0

# Data Retention (days)
SENSOR_DATA_RETENTION=7
GPS_DATA_RETENTION=30
